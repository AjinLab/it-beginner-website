<%- include('partials/head') %>

<div class="page-wrapper">
  <%- include('partials/sidebar') %>

  <main class="main-content">
    <div class="page-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
      <div>
        <h1>💻 Interactive Code Playground</h1>
        <p>Write, run, and experiment with HTML, CSS, and JavaScript in real-time</p>
      </div>
      <div style="display:flex;gap:8px;">
        <button class="btn btn-secondary btn-sm" onclick="resetEditor()">🔄 Reset</button>
        <button class="btn btn-secondary btn-sm" onclick="openSaveModal()">💾 Save Snippet</button>
        <button class="btn btn-primary btn-sm" onclick="runCode()">▶️ Run Code</button>
      </div>
    </div>

    <!-- Presets bar -->
    <div class="card mb-2" style="padding:12px 16px;">
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <span style="font-size:0.85rem;font-weight:600;color:var(--text-secondary);">📚 Course Practice Presets:</span>
        <% presets.forEach(function(preset) { %>
          <button class="preset-btn" onclick="loadPreset('<%= preset.id %>')">
            <%= preset.title %>
          </button>
        <% }); %>
      </div>
    </div>

    <% if (savedSnippets.length > 0) { %>
    <div class="card mb-2" style="padding:12px 16px;">
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <span style="font-size:0.85rem;font-weight:600;color:var(--text-secondary);">📂 My Saved Snippets:</span>
        <% savedSnippets.forEach(function(snip) { %>
          <button class="preset-btn" onclick="loadSavedSnippet(<%= snip.id %>)">
            📝 <%= snip.title %>
          </button>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- Playground Workspace -->
    <div class="playground-layout">
      <!-- Editor Column -->
      <div class="playground-editor-pane card" style="padding:0;overflow:hidden;display:flex;flex-direction:column;">
        <div class="playground-tabs">
          <button class="pg-tab active" onclick="switchEditorTab('html')">HTML</button>
          <button class="pg-tab" onclick="switchEditorTab('css')">CSS</button>
          <button class="pg-tab" onclick="switchEditorTab('js')">JavaScript</button>
        </div>

        <div class="editor-container" style="flex:1;display:flex;flex-direction:column;">
          <textarea id="htmlCode" class="code-textarea active" placeholder="<!-- Write your HTML here -->" spellcheck="false"></textarea>
          <textarea id="cssCode" class="code-textarea" placeholder="/* Write your CSS here */" spellcheck="false"></textarea>
          <textarea id="jsCode" class="code-textarea" placeholder="// Write your JavaScript here" spellcheck="false"></textarea>
        </div>
      </div>

      <!-- Preview Column -->
      <div class="playground-preview-pane card" style="padding:0;overflow:hidden;display:flex;flex-direction:column;">
        <div class="preview-header">
          <span style="font-size:0.85rem;font-weight:600;">👁️ Live Preview</span>
          <span class="badge badge-info" id="statusBadge">Live Sandbox</span>
        </div>

        <div style="flex:1;min-height:300px;background:#fff;border-bottom:1px solid var(--border);">
          <iframe id="previewFrame" style="width:100%;height:100%;border:none;" sandbox="allow-scripts"></iframe>
        </div>

        <!-- Terminal Console -->
        <div class="playground-console">
          <div class="console-header">
            <span>📟 Output Console</span>
            <button class="btn btn-sm btn-secondary" onclick="clearConsole()" style="padding:2px 8px;font-size:0.75rem;">Clear</button>
          </div>
          <div class="console-body" id="consoleOutput">
            <div class="console-msg log">Console ready. Click 'Run Code' or press Ctrl+Enter.</div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Save Snippet Modal -->
<div id="saveModal" class="modal-overlay" style="display:none;">
  <div class="card modal-content" style="max-width:400px;margin:10% auto;">
    <h3 class="mb-2">Save Code Snippet</h3>
    <div class="form-group">
      <label class="form-label">Snippet Title</label>
      <input type="text" id="snippetTitleInput" class="form-input" placeholder="e.g. My Array Exercise">
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:16px;">
      <button class="btn btn-secondary" onclick="closeSaveModal()">Cancel</button>
      <button class="btn btn-primary" onclick="confirmSaveSnippet()">Save</button>
    </div>
  </div>
</div>

<script>
const PRESETS = <%- JSON.stringify(presets) %>;
let currentPresetId = 'js-variables';
let activeSnippetId = null;

function switchEditorTab(tab) {
  document.querySelectorAll('.pg-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.code-textarea').forEach(a => a.classList.remove('active'));
  
  event.target.classList.add('active');
  document.getElementById(tab + 'Code').classList.add('active');
}

function loadPreset(presetId) {
  const preset = PRESETS.find(p => p.id === presetId);
  if (!preset) return;
  currentPresetId = presetId;
  activeSnippetId = null;

  document.getElementById('htmlCode').value = preset.html;
  document.getElementById('cssCode').value = preset.css;
  document.getElementById('jsCode').value = preset.js;

  runCode();
}

function resetEditor() {
  loadPreset(currentPresetId);
}

function clearConsole() {
  document.getElementById('consoleOutput').innerHTML = '';
}

function logToConsole(type, message) {
  const box = document.getElementById('consoleOutput');
  const div = document.createElement('div');
  div.className = 'console-msg ' + type;
  div.textContent = (type === 'error' ? '❌ ' : type === 'warn' ? '⚠️ ' : '❯ ') + message;
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
}

function runCode() {
  const html = document.getElementById('htmlCode').value;
  const css = document.getElementById('cssCode').value;
  const js = document.getElementById('jsCode').value;

  clearConsole();
  logToConsole('log', 'Executing code...');

  const combined = `
    <!DOCTYPE html>
    <html>
      <head>
        <meta charset="UTF-8">
        <style>
          body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            margin: 16px;
            color: #333;
          }
          ${css}
        </style>
        <script>
          // Override console
          window.console = {
            log: function(...args) {
              window.parent.postMessage({ type: 'log', message: args.map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' ') }, '*');
            },
            error: function(...args) {
              window.parent.postMessage({ type: 'error', message: args.map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' ') }, '*');
            },
            warn: function(...args) {
              window.parent.postMessage({ type: 'warn', message: args.map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' ') }, '*');
            }
          };
          window.onerror = function(msg, url, line) {
            window.parent.postMessage({ type: 'error', message: msg + ' (Line: ' + line + ')' }, '*');
          };
        <\/script>
      </head>
      <body>
        ${html}
        <script>
          try {
            ${js}
          } catch(err) {
            console.error(err.message);
          }
        <\/script>
      </body>
    </html>
  `;

  const frame = document.getElementById('previewFrame');
  frame.srcdoc = combined;
}

window.addEventListener('message', function(e) {
  if (e.data && e.data.type) {
    logToConsole(e.data.type, e.data.message);
  }
});

// Shortcut: Ctrl+Enter / Cmd+Enter runs code
document.addEventListener('keydown', function(e) {
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
    e.preventDefault();
    runCode();
  }
});

// Modal helpers
function openSaveModal() {
  document.getElementById('saveModal').style.display = 'block';
}
function closeSaveModal() {
  document.getElementById('saveModal').style.display = 'none';
}

function confirmSaveSnippet() {
  const title = document.getElementById('snippetTitleInput').value.trim();
  if (!title) return alert('Please enter a title');

  const html = document.getElementById('htmlCode').value;
  const css = document.getElementById('cssCode').value;
  const js = document.getElementById('jsCode').value;

  fetch('/api/playground/save', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      title,
      html_code: html,
      css_code: css,
      js_code: js,
      snippet_id: activeSnippetId
    })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      alert('✅ Snippet saved!');
      closeSaveModal();
      location.reload();
    } else {
      alert('Error: ' + data.error);
    }
  });
}

function loadSavedSnippet(id) {
  fetch('/api/playground/snippet/' + id)
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        activeSnippetId = data.snippet.id;
        document.getElementById('htmlCode').value = data.snippet.html_code || '';
        document.getElementById('cssCode').value = data.snippet.css_code || '';
        document.getElementById('jsCode').value = data.snippet.js_code || '';
        document.getElementById('snippetTitleInput').value = data.snippet.title;
        runCode();
      }
    });
}

// Initial run
document.addEventListener('DOMContentLoaded', () => {
  loadPreset('js-variables');
});
</script>

<%- include('partials/footer') %>


<%- include('partials/head') %>

<div class="page-wrapper">
  <%- include('partials/sidebar') %>

  <main class="main-content">
    <div class="breadcrumb">
      <a href="/dashboard">Dashboard</a> / 
      <a href="/courses">Chapters</a> / 
      <a href="/chapter/<%= chapter.id %>"><%= chapter.title %></a> / 
      <span><%= lesson.title %></span>
    </div>

    <div class="grid-2">
      <!-- Main Video & Content Column -->
      <div>
        <!-- Video Player -->
        <div class="video-container">
          <video 
            id="videoPlayer" 
            controls 
            preload="metadata"
            data-lesson-id="<%= lesson.id %>"
            data-start-position="<%= progress.last_position_seconds || 0 %>"
          >
            <source src="/videos/<%= encodeURIComponent(lesson.video_filename) %>" type="video/mp4">
            Your browser does not support the video element.
          </video>
        </div>

        <!-- Video Player Auxiliary Controls -->
        <div class="video-controls-bar">
          <div class="video-nav">
            <% if (prevLesson) { %>
              <a href="/lesson/<%= prevLesson.id %>" class="btn btn-secondary btn-sm" id="prevLessonBtn">← Previous</a>
            <% } %>
            <% if (nextLesson) { %>
              <a href="/lesson/<%= nextLesson.id %>" class="btn btn-primary btn-sm" id="nextLessonBtn">Next →</a>
            <% } %>
          </div>

          <!-- Speed & Shortcut controls -->
          <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
            <div class="speed-selector" style="display:flex;background:var(--bg-card);border:1px solid var(--border);border-radius:6px;padding:2px;">
              <button class="speed-btn active" onclick="setSpeed(1, this)">1x</button>
              <button class="speed-btn" onclick="setSpeed(1.25, this)">1.25x</button>
              <button class="speed-btn" onclick="setSpeed(1.5, this)">1.5x</button>
              <button class="speed-btn" onclick="setSpeed(2, this)">2x</button>
            </div>

            <button class="btn btn-secondary btn-sm" onclick="toggleShortcutsModal()" title="Keyboard Shortcuts">
              ⌨️
            </button>

            <button class="btn btn-bookmark btn-icon <%= isBookmarked ? 'active' : '' %>" id="bookmarkBtn" onclick="toggleBookmark(<%= lesson.id %>)" title="Bookmark">
              🔖
            </button>
            <button class="btn btn-success btn-sm" id="markCompleteBtn" onclick="markComplete(<%= lesson.id %>)">
              <%= progress.status === 'completed' ? '✅ Completed' : 'Mark Complete' %>
            </button>
          </div>
        </div>

        <!-- Lesson Info -->
        <div class="card mb-3">
          <h2><%= lesson.title %></h2>
          <p style="color:var(--text-secondary);margin-top:4px;"><%= lesson.description %></p>
          <div style="margin-top:12px;display:flex;gap:16px;font-size:0.85rem;color:var(--text-muted);flex-wrap:wrap;">
            <span><%= chapter.icon %> <%= chapter.title %></span>
            <span>📹 Lesson <%= lesson.order_index %> of <%= chapterLessons.length %></span>
            <span id="progressDisplay">
              <% if (progress.status === 'completed') { %>
                ✅ Completed
              <% } else { %>
                ▶️ <%= progress.progress_percent || 0 %>%
              <% } %>
            </span>
          </div>
        </div>

        <!-- Lesson Tabs -->
        <div class="tabs">
          <button class="tab active" onclick="switchLessonTab('qa')">💬 Q&A & Community (<%= discussions.length %>)</button>
          <button class="tab" onclick="switchLessonTab('notes')">📝 Notes (<%= notes.length %>)</button>
          <button class="tab" onclick="switchLessonTab('scratchpad')">💻 Live Scratchpad</button>
          <button class="tab" onclick="switchLessonTab('summary')">📋 Key Takeaways</button>
        </div>

        <!-- Tab 1: Q&A / Discussions -->
        <div class="tab-content active" id="tab-qa">
          <div class="card">
            <h3 class="mb-2">Questions & Discussions</h3>
            <p style="font-size:0.85rem;color:var(--text-secondary);margin-bottom:16px;">
              Have a question about this lesson? Ask below and get answers from instructors and fellow students!
            </p>

            <!-- New Question Form -->
            <div style="margin-bottom:24px;">
              <textarea id="questionInput" class="form-input" placeholder="What is your question or thought on this lesson?" rows="3"></textarea>
              <div style="display:flex;justify-content:flex-end;margin-top:8px;">
                <button class="btn btn-primary btn-sm" onclick="postDiscussion(<%= lesson.id %>, null)">
                  Ask Question
                </button>
              </div>
            </div>

            <!-- Discussions List -->
            <div id="discussionsContainer">
              <% if (discussions.length === 0) { %>
                <div class="empty-state" id="emptyDiscussions" style="padding:20px;">
                  <div class="empty-icon">💬</div>
                  <p>No questions yet. Be the first to ask!</p>
                </div>
              <% } %>

              <% discussions.forEach(function(disc) { %>
                <div class="discussion-card card mb-2" id="discussion-<%= disc.id %>" style="background:var(--bg-secondary);padding:16px;">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
                    <div style="display:flex;gap:10px;align-items:center;">
                      <div class="user-avatar" style="width:32px;height:32px;font-size:0.8rem;">
                        <%= disc.full_name ? disc.full_name.charAt(0).toUpperCase() : 'U' %>
                      </div>
                      <div>
                        <strong><%= disc.full_name %></strong>
                        <% if (disc.role === 'admin') { %>
                          <span class="badge badge-warning" style="font-size:0.7rem;margin-left:4px;">👨‍🏫 Instructor</span>
                        <% } %>
                        <div style="font-size:0.75rem;color:var(--text-muted);"><%= new Date(disc.created_at).toLocaleDateString() %></div>
                      </div>
                    </div>

                    <div style="display:flex;align-items:center;gap:8px;">
                      <button class="btn-upvote <%= disc.user_has_upvoted ? 'active' : '' %>" onclick="upvoteDiscussion(<%= disc.id %>, this)">
                        ▲ <span class="upvote-count"><%= disc.upvotes %></span>
                      </button>
                      <% if (user.id === disc.user_id || user.role === 'admin') { %>
                        <button class="note-delete" onclick="deleteDiscussion(<%= disc.id %>)">✕</button>
                      <% } %>
                    </div>
                  </div>

                  <div style="margin:12px 0;font-size:0.95rem;line-height:1.5;">
                    <%= disc.content %>
                  </div>

                  <button class="btn btn-secondary btn-sm" onclick="toggleReplyBox(<%= disc.id %>)" style="font-size:0.75rem;padding:4px 8px;">
                    ↩ Reply
                  </button>

                  <!-- Inline Reply Box -->
                  <div id="replyBox-<%= disc.id %>" style="display:none;margin-top:12px;">
                    <textarea id="replyInput-<%= disc.id %>" class="form-input" placeholder="Write your reply..." rows="2"></textarea>
                    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:6px;">
                      <button class="btn btn-secondary btn-sm" onclick="toggleReplyBox(<%= disc.id %>)">Cancel</button>
                      <button class="btn btn-primary btn-sm" onclick="postDiscussion(<%= lesson.id %>, <%= disc.id %>)">Reply</button>
                    </div>
                  </div>

                  <!-- Replies list -->
                  <% if (disc.replies && disc.replies.length > 0) { %>
                    <div class="replies-list" style="margin-top:16px;padding-left:16px;border-left:2px solid var(--border);">
                      <% disc.replies.forEach(function(rep) { %>
                        <div class="reply-item mb-2" id="discussion-<%= rep.id %>" style="padding:10px;background:rgba(255,255,255,0.03);border-radius:6px;">
                          <div style="display:flex;justify-content:space-between;align-items:center;">
                            <div style="display:flex;align-items:center;gap:8px;">
                              <strong><%= rep.full_name %></strong>
                              <% if (rep.role === 'admin') { %>
                                <span class="badge badge-warning" style="font-size:0.65rem;">👨‍🏫 Instructor</span>
                              <% } %>
                              <span style="font-size:0.75rem;color:var(--text-muted);"><%= new Date(rep.created_at).toLocaleDateString() %></span>
                            </div>
                            <% if (user.id === rep.user_id || user.role === 'admin') { %>
                              <button class="note-delete" onclick="deleteDiscussion(<%= rep.id %>)">✕</button>
                            <% } %>
                          </div>
                          <div style="margin-top:6px;font-size:0.9rem;">
                            <%= rep.content %>
                          </div>
                        </div>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- Tab 2: Notes -->
        <div class="tab-content" id="tab-notes">
          <div class="card notes-section" style="margin-top:0;">
            <div class="card-header">
              <span class="card-title">📝 Timestamped Notes</span>
              <span class="badge badge-info"><%= notes.length %> saved</span>
            </div>

            <!-- Add Note Form -->
            <div style="display:flex;gap:8px;margin-bottom:16px;">
              <input type="text" id="noteInput" class="form-input" placeholder="Type a note... (captured at current video timestamp)" style="flex:1;">
              <button class="btn btn-primary" onclick="addNote(<%= lesson.id %>)">Add Note</button>
            </div>

            <!-- Notes List -->
            <div id="notesList">
              <% if (notes.length === 0) { %>
                <div class="empty-state" style="padding:16px;" id="emptyNotes">
                  <p class="text-muted">No notes yet. Add one while watching!</p>
                </div>
              <% } %>
              <% notes.forEach(function(note) { %>
                <div class="note-item" id="note-<%= note.id %>">
                  <span class="note-timestamp" onclick="seekTo(<%= note.timestamp_seconds %>)">
                    ⏱️ <%= formatTimestamp(note.timestamp_seconds) %>
                  </span>
                  <span class="note-content"><%= note.content %></span>
                  <button class="note-delete" onclick="deleteNote(<%= note.id %>)">✕</button>
                </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- Tab 3: Mini Scratchpad -->
        <div class="tab-content" id="tab-scratchpad">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">💻 Live In-Lesson Scratchpad</h3>
              <button class="btn btn-primary btn-sm" onclick="runScratchpad()">▶️ Run Code</button>
            </div>
            <textarea id="scratchpadCode" class="form-input code-textarea" style="height:140px;font-family:monospace;font-size:0.9rem;" spellcheck="false">// Try JavaScript code while following the video!
const lesson = "<%= lesson.title %>";
console.log("Practicing on: " + lesson);

// Try arithmetic or string operations:
let result = [10, 20, 30].map(n => n * 2);
console.log("Mapped results:", result);</textarea>

            <div class="playground-console mt-2" style="max-height:160px;">
              <div class="console-header">
                <span>Output Console</span>
                <button class="btn btn-sm btn-secondary" onclick="document.getElementById('scratchpadOutput').innerHTML=''" style="padding:2px 8px;font-size:0.75rem;">Clear</button>
              </div>
              <div class="console-body" id="scratchpadOutput" style="min-height:60px;">
                <div class="console-msg log">Ready. Click 'Run Code' to execute.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab 4: Lesson Summary & Key Takeaways -->
        <div class="tab-content" id="tab-summary">
          <div class="card">
            <h3>📋 Lesson Key Takeaways</h3>
            <div style="margin-top:12px;line-height:1.7;color:var(--text-secondary);">
              <p><strong>Lesson Title:</strong> <%= lesson.title %></p>
              <p><strong>Chapter:</strong> <%= chapter.title %></p>
              <p style="margin-top:10px;"><strong>Summary:</strong> <%= lesson.description %></p>
              
              <div class="alert alert-info mt-2" style="font-size:0.85rem;">
                💡 <strong>Learning Tip:</strong> Active recall and hands-on coding lead to 80% higher retention. Make sure to try writing the code shown in this video using the <strong>Live Scratchpad</strong> tab or the full <strong><a href="/playground" style="text-decoration:underline;">Code Playground</a></strong>!
              </div>

              <div class="mt-2">
                <a href="/quiz/<%= chapter.id %>" class="btn btn-secondary btn-sm">Take <%= chapter.title %> Quiz →</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Chapter Lessons Sidebar -->
      <div class="lesson-sidebar">
        <div class="card">
          <div class="card-header">
            <span class="card-title"><%= chapter.icon %> <%= chapter.title %></span>
          </div>
          <div class="lesson-list-compact">
            <% chapterLessons.forEach(function(cl, i) { %>
              <a href="/lesson/<%= cl.id %>" class="lesson-item <%= cl.id === lesson.id ? 'current' : '' %>" style="font-size:0.85rem;padding:10px;">
                <div class="lesson-number" style="width:28px;height:28px;font-size:0.75rem;"><%= i + 1 %></div>
                <div class="lesson-info">
                  <div class="lesson-title" style="font-size:0.85rem;"><%= cl.title %></div>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Keyboard Shortcuts Modal -->
<div id="shortcutsModal" class="modal-overlay" style="display:none;" onclick="if(event.target===this) toggleShortcutsModal()">
  <div class="card modal-content" style="max-width:440px;margin:12% auto;">
    <div class="card-header">
      <h3>⌨️ Video Keyboard Shortcuts</h3>
      <button class="note-delete" onclick="toggleShortcutsModal()">✕</button>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:0.9rem;margin-top:12px;">
      <div><kbd>Space</kbd> or <kbd>K</kbd></div><div>Play / Pause</div>
      <div><kbd>←</kbd> (Left Arrow)</div><div>Seek backward 5s</div>
      <div><kbd>→</kbd> (Right Arrow)</div><div>Seek forward 5s</div>
      <div><kbd>M</kbd></div><div>Mute / Unmute</div>
      <div><kbd>F</kbd></div><div>Toggle Fullscreen</div>
    </div>
  </div>
</div>

<%

function formatTimestamp(seconds) {
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return m.toString().padStart(2, '0') + ':' + s.toString().padStart(2, '0');
}

%>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const video = document.getElementById('videoPlayer');
  if (!video) return;

  const startPos = parseInt(video.dataset.startPosition) || 0;
  const lessonId = video.dataset.lessonId;

  // Resume from last position
  video.addEventListener('loadedmetadata', function() {
    if (startPos > 0 && startPos < video.duration - 5) {
      video.currentTime = startPos;
    }
  });

  // Track progress periodically
  let lastSave = 0;
  video.addEventListener('timeupdate', function() {
    const now = Date.now();
    if (now - lastSave < 10000) return; // Save every 10 seconds
    lastSave = now;
    
    const percent = Math.round((video.currentTime / video.duration) * 100);
    saveProgress(lessonId, percent, Math.floor(video.currentTime));
  });

  // Save on pause
  video.addEventListener('pause', function() {
    const percent = Math.round((video.currentTime / video.duration) * 100);
    saveProgress(lessonId, percent, Math.floor(video.currentTime));
  });

  // Mark complete when video ends
  video.addEventListener('ended', function() {
    saveProgress(lessonId, 100, Math.floor(video.duration), 'completed');
    document.getElementById('progressDisplay').innerHTML = '✅ Completed';
    document.getElementById('markCompleteBtn').textContent = '✅ Completed';
  });

  // Global Keyboard Shortcuts
  document.addEventListener('keydown', function(e) {
    // Ignore if user is typing in inputs or textareas
    if (['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

    if (e.code === 'Space' || e.key === 'k') {
      e.preventDefault();
      video.paused ? video.play() : video.pause();
    } else if (e.code === 'ArrowLeft') {
      e.preventDefault();
      video.currentTime = Math.max(0, video.currentTime - 5);
    } else if (e.code === 'ArrowRight') {
      e.preventDefault();
      video.currentTime = Math.min(video.duration, video.currentTime + 5);
    } else if (e.key === 'm') {
      video.muted = !video.muted;
    } else if (e.key === 'f') {
      if (!document.fullscreenElement) {
        video.requestFullscreen().catch(()=>{});
      } else {
        document.exitFullscreen().catch(()=>{});
      }
    }
  });
});

function setSpeed(speed, btn) {
  const video = document.getElementById('videoPlayer');
  if (video) {
    video.playbackRate = speed;
    document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }
}

function toggleShortcutsModal() {
  const m = document.getElementById('shortcutsModal');
  m.style.display = m.style.display === 'none' ? 'block' : 'none';
}

function switchLessonTab(tab) {
  document.querySelectorAll('.tabs .tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));
  
  event.target.classList.add('active');
  document.getElementById('tab-' + tab).classList.add('active');
}

function saveProgress(lessonId, percent, position, status) {
  fetch('/api/progress/' + lessonId, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      progressPercent: percent,
      positionSeconds: position,
      status: status
    })
  });
}

function toggleBookmark(lessonId) {
  fetch('/api/bookmark/' + lessonId, { method: 'POST' })
    .then(r => r.json())
    .then(data => {
      const btn = document.getElementById('bookmarkBtn');
      btn.classList.toggle('active', data.bookmarked);
    });
}

function markComplete(lessonId) {
  saveProgress(lessonId, 100, 0, 'completed');
  document.getElementById('progressDisplay').innerHTML = '✅ Completed';
  document.getElementById('markCompleteBtn').textContent = '✅ Completed';
  document.getElementById('markCompleteBtn').disabled = true;
}

function addNote(lessonId) {
  const input = document.getElementById('noteInput');
  const content = input.value.trim();
  if (!content) return;

  const video = document.getElementById('videoPlayer');
  const ts = Math.floor(video ? video.currentTime : 0);

  fetch('/api/notes/' + lessonId, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ content, timestampSeconds: ts })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      const emptyEl = document.getElementById('emptyNotes');
      if (emptyEl) emptyEl.remove();

      const m = Math.floor(ts / 60).toString().padStart(2, '0');
      const s = (ts % 60).toString().padStart(2, '0');

      const noteHtml = `
        <div class="note-item" id="note-${data.note.id}">
          <span class="note-timestamp" onclick="seekTo(${ts})">⏱️ ${m}:${s}</span>
          <span class="note-content">${content}</span>
          <button class="note-delete" onclick="deleteNote(${data.note.id})">✕</button>
        </div>
      `;
      document.getElementById('notesList').insertAdjacentHTML('beforeend', noteHtml);
      input.value = '';
    }
  });
}

function deleteNote(noteId) {
  fetch('/api/notes/' + noteId, { method: 'DELETE' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        document.getElementById('note-' + noteId).remove();
      }
    });
}

function seekTo(seconds) {
  const video = document.getElementById('videoPlayer');
  if (video) {
    video.currentTime = seconds;
    video.play();
  }
}

// Q&A / Discussions Functions
function toggleReplyBox(id) {
  const box = document.getElementById('replyBox-' + id);
  box.style.display = box.style.display === 'none' ? 'block' : 'none';
}

function postDiscussion(lessonId, parentId) {
  const input = parentId ? document.getElementById('replyInput-' + parentId) : document.getElementById('questionInput');
  const content = input.value.trim();
  if (!content) return;

  fetch('/api/discussions/' + lessonId, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ content, parentId })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      location.reload();
    } else {
      alert('Error: ' + data.error);
    }
  });
}

function upvoteDiscussion(id, btn) {
  fetch('/api/discussions/' + id + '/upvote', { method: 'POST' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        btn.classList.toggle('active', data.upvoted);
        btn.querySelector('.upvote-count').textContent = data.upvotes;
      }
    });
}

function deleteDiscussion(id) {
  if (!confirm('Are you sure you want to delete this discussion post?')) return;
  fetch('/api/discussions/' + id, { method: 'DELETE' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        document.getElementById('discussion-' + id).remove();
      }
    });
}

// In-Lesson Scratchpad
function runScratchpad() {
  const code = document.getElementById('scratchpadCode').value;
  const out = document.getElementById('scratchpadOutput');
  out.innerHTML = '';

  const customLog = (...args) => {
    const div = document.createElement('div');
    div.className = 'console-msg log';
    div.textContent = '❯ ' + args.map(a => typeof a === 'object' ? JSON.stringify(a) : String(a)).join(' ');
    out.appendChild(div);
  };

  try {
    const fn = new Function('console', code);
    fn({ log: customLog, error: customLog, warn: customLog });
  } catch(err) {
    const div = document.createElement('div');
    div.className = 'console-msg error';
    div.textContent = '❌ ' + err.message;
    out.appendChild(div);
  }
}
</script>

<%- include('partials/footer') %>
